# Placeholder only: never commit /etc/swollenhippo.env or actual passwords.
# mysql_portal.py does not automatically load a .env file. systemd loads its
# EnvironmentFile; local runs must supply these values in the process environment.
MYSQL_DATABASE_URL="mysql+pymysql://hippo_api:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost/swollenhippo_db?unix_socket=/run/mysqld/mysqld.sock&charset=utf8mb4"
APP_ENV="production"
COOKIE_SECURE="true"
APP_DATA_DIR="/var/lib/swollenhippo"
APP_TEMPLATE_PATH="/opt/swollenhippo/templates/index.html"
